# SimpleRisk APP-STACK secrets & config (compose.app.yml).
#
# Copy to .env and fill in. .env is gitignored (.gitignore) and is the ONLY
# place the app stack's secrets live. compose.app.yml uses it two ways: as the
# container env_file (every var below reaches the entrypoint) and as the compose
# interpolation source (the ${VAR} references in compose.app.yml).
#
# Support-stack vars (MariaDB root password, OpenLDAP admin password, SMTP relay
# creds) live in a SEPARATE file: copy .env.support.example to .env.support.
#
# Below, every var the app stack can read is listed. Values are BLANK — fill in
# what you need. The dev stack ships real values in .env only where it uses them
# and leaves the rest blank; for any non-throwaway deployment replace every set
# value with a strong, unique one.

# ---------------------------------------------------------------------------
# Database — the app's OWN user (NOT the root password)
# ---------------------------------------------------------------------------
# Host/port are compose-hardcoded: host.containers.internal:3306 (the app
# reaches the support MariaDB over Podman's host-gateway). Username/database
# default to `simplerisk`; uncomment to override.
SIMPLERISK_DB_PASSWORD=
#SIMPLERISK_DB_USERNAME=simplerisk
#SIMPLERISK_DB_DATABASE=simplerisk
# Optional: path to a CA bundle to require TLS to the DB (none in dev).
SIMPLERISK_DB_SSL_CERT_PATH=
# Optional: store PHP sessions in the DB instead of files (default true).
SIMPLERISK_DB_FOR_SESSIONS=true

# ---------------------------------------------------------------------------
# First-boot DB provisioning (DB_SETUP=automatic)
# ---------------------------------------------------------------------------
# The entrypoint creates the `simplerisk` DB + app user + core schema on first
# boot (idempotent — safe to leave set across reboots/rebuilds).
DB_SETUP=automatic
# Bootstrap ROOT credential used once to do that provisioning. It MUST equal
# MARIADB_ROOT_PASSWORD in .env.support (the support stack's MariaDB root
# password) — the app connects as root to create the DB/user.
DB_SETUP_PASS=
DB_SETUP_WAIT=30
# Optional: bootstrap DB user (default root).
DB_SETUP_USER=root

# ---------------------------------------------------------------------------
# Application security secrets
# ---------------------------------------------------------------------------
# Encryption Extra key (env takes precedence over the settings table). With no
# key, encrypted fields render as "XXXX". Generate:  openssl rand -hex 32
SIMPLERISK_ENCRYPTION_KEY=
# Optional: CSRF secret. If unset, csrf-magic generates one on first request.
# Generate:  openssl rand -hex 32
SIMPLERISK_CSRF_SECRET=

# ---------------------------------------------------------------------------
# Custom Authentication (LDAP) extra
# ---------------------------------------------------------------------------
# Bind (service-account) password. ldapauth_bind_password() reads this env var
# first (then config.php, then the settings table), keeping the secret out of
# the DB. The LDAP connection settings themselves (host, base DN, etc.) are
# seeded by seed-ldap-settings.php; only the password is an env secret.
LDAP_BIND_PASSWORD=

# ---------------------------------------------------------------------------
# Outbound mail (PHPMailer). All optional — leave blank for SimpleRisk defaults.
# Requires the support stack's smtp service, started with:
#   podman compose -f compose.support.yml --profile mail up -d
# reached at host.containers.internal:1025 (rootless Podman can't bind host 25).
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=             # smtp | sendmail
MAIL_HOST=
MAIL_PORT=
MAIL_ENCRYPTION=            # none | tls | ssl
MAIL_SMTPAUTH=              # true | false
MAIL_SMTPAUTOTLS=           # true | false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLYTO_EMAIL=
MAIL_REPLYTO_NAME=
MAIL_PREPEND=

# ---------------------------------------------------------------------------
# Optional first DB-local admin (skipped if ADMIN_USERNAME is blank — LDAP
# auto-provision is the default login path). Idempotent.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Behavior toggles (not secrets)
# ---------------------------------------------------------------------------
# Gate the dev LDAP-connection seeder (1 = seed after provisioning; default 1).
SEED_LDAP_SETTINGS=1
# Set to `disabled` to stop SimpleRisk's cron from running inside the container
# (leave blank = enabled). Set disabled if cron is managed externally.
SIMPLERISK_CRON_SETUP=
