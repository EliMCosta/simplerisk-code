
*.swp
.vscode

extras

# TLS material generated by the entrypoint into ./certs — contains PRIVATE KEYS, never commit.
# Drop in your own ca/ + simplerisk/ files to use a real certificate.
certs/*
!certs/.gitkeep

# Secrets — never commit.
.env
.env.support
extras/*

# PHPUnit phar (auto-fetched into tests/tools on first run) + result cache.
tests/tools/*.phar
tests/tools/.phpunit.cache
# Generated code-coverage report (bin/test --coverage, via pcov).
tests/tools/coverage/
tests/tools/.coverage