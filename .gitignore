
*.swp
.vscode

# Nested npm peer-dep installs under vendored frontend libs (e.g. datatables/*/node_modules/jquery).
# Top-level simplerisk/vendor/node_modules is vendored core and must stay tracked.
**/node_modules/**/node_modules
simplerisk/vendor/swagger-api/swagger-ui/node_modules

extras

# TLS material generated by the entrypoint into ./certs — contains PRIVATE KEYS, never commit.
# Drop in your own ca/ + simplerisk/ files to use a real certificate.
certs/*
!certs/.gitkeep

# Secrets — never commit.
.env
.env.support
extras/*

# PHPUnit phar (auto-fetched into tests/tools on first run) + result cache.
tests/tools/*.phar
tests/tools/.phpunit.cache
tests/tools/.phpunit.result.cache
# Generated code-coverage report (bin/test --coverage, via pcov).
tests/tools/coverage/
tests/tools/.coverage