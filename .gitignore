
*.swp
.vscode

# Per-instance extra configs (api/encryption/authentication/… hold secrets/CORS/LDAP
# settings) — never commit. (The old simplerisk/extras/mcp path was stale: MCP lives in
# the api extra.)
extras/*/config.php

# Runtime data written by extras (e.g. SCF / import-export CSVs). Keep the placeholders
# so the directories exist.
extras/*/data/*
!extras/*/data/.gitkeep

# TLS material generated by the entrypoint into ./certs — contains PRIVATE KEYS, never commit.
# Drop in your own ca/ + simplerisk/ files to use a real certificate.
certs/*
!certs/.gitkeep

# Secrets — never commit.
.env
.env.support
extras/*