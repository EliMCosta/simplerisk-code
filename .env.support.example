# SimpleRisk SUPPORT-STACK vars (compose.support.yml): MariaDB + OpenLDAP +
# optional SMTP relay. Copied to .env.support (gitignored). compose.support.yml
# loads it via env_file on each service.
#
# The app stack does NOT read this file. The one coupling: the app's
# DB_SETUP_PASS (in .env) MUST equal MARIADB_ROOT_PASSWORD below, because the app
# bootstraps the `simplerisk` DB + user as root.
#
# Values below are BLANK — fill in what you need. LDAP_ORGANISATION / LDAP_DOMAIN
# / LDAP_TLS are pinned to the dev directory (they must match ldap-seed.ldif and
# seed-ldap-settings.php), so change them only if you also update those files.

# ---------------------------------------------------------------------------
# MariaDB
# ---------------------------------------------------------------------------
# Root password. Created EMPTY (root only); the app provisions the `simplerisk`
# DB + user as root (DB_SETUP=automatic). MUST equal DB_SETUP_PASS in .env.
MARIADB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# OpenLDAP (osixia/openldap) — demo directory for the Custom Auth extra
# ---------------------------------------------------------------------------
LDAP_ADMIN_PASSWORD=
LDAP_ORGANISATION=SimpleRisk Dev
LDAP_DOMAIN=simplerisk.local
LDAP_TLS=false              # plaintext (dev directory)

# ---------------------------------------------------------------------------
# SMTP relay (namshi/smtp) — optional; start with --profile mail. Blank = local
# open relay (dev). For an authenticated upstream relay, set RELAY_*.
# ---------------------------------------------------------------------------
RELAY_HOST=
RELAY_PORT=
RELAY_USERNAME=
RELAY_PASSWORD=
